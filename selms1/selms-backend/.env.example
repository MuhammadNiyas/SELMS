# Copy this file to .env and fill in real values. .env is gitignored —
# .env.example is just a template showing what's needed, safe to commit.

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=selms
JWT_SECRET=change-this-to-any-random-string
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-character-gmail-app-password

# Optional - only needed so onboarding email confirm links work from
# devices other than this one (e.g. an ngrok tunnel URL). Leave unset to
# have links default to whatever host the request arrived on (localhost).
PUBLIC_BASE_URL=

# Google Calendar / Meet - lets SELMS create a Meet link for online
# orientation sessions. From Google Cloud Console > Google Auth Platform >
# Clients (Web application; redirect URI must match exactly).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/google/callback

# Where returned equipment is posted to (shown on offboarding shipments).
COMPANY_NAME=
COMPANY_ADDRESS=
COMPANY_PHONE=

# Where leavers bring their equipment back (shown on their Return equipment page).
EQUIPMENT_RETURN_LOCATION=the IT department
